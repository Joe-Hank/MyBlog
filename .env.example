# Claude-MyBlog environment variables template
# Copy to .env (already gitignored). NEVER commit real keys.

# ── 阿里云国内部署（scripts/deploy-oss.ps1 使用）──────────────────
# 用 RAM 子账号，最小权限：目标桶 PutObject/DeleteObject + cdn:RefreshObjectCaches
OSS_BUCKET=
OSS_ENDPOINT=            # 如 oss-cn-shanghai.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
CDN_DOMAIN=joecloud.asia

# ── 海外版 Notion 代理（仅 Cloudflare Worker 用，不在本仓库/前端）──
# NOTION_TOKEN=          # 千万不要放进国内基础设施 / 前端 / 仓库
